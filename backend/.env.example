# TaxiPay Backend Environment Configuration
# Copy this file to .env and fill in your values.

NODE_ENV=development
PORT=5001

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/taxipay
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2

# JWT Authentication
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=1d

# Express Session
SESSION_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET
SESSION_COOKIE_NAME=taxipay.sid
SESSION_TTL_MS=604800000

# CORS - Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Request Limits
REQUEST_BODY_LIMIT=1mb

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=
